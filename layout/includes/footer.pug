#footer.layout
  - var now = new Date()
  - var nowYear = now.getFullYear()
  - var startYear = new Date(2025, 0, 1).getFullYear()
  if startYear && startYear != nowYear
    .copyright!= `&copy;${startYear} - ${nowYear} By ${config.author}`
  else
    .copyright!= `&copy;${nowYear} By ${config.author}`
  .framework-info
    span= _p('footer.driven') + ' - '
    a(href='http://hexo.io')
      span Hexo
    span.footer-separator |
    span= _p('footer.theme') + ' - '
    a(href='https://github.com/Molunerfinn/hexo-theme-melody')
      span Melody
  if theme.footer_custom_text
    .footer_custom_text!=`${theme.footer_custom_text}`   
